{
  "name": "codegen-plugin",
  "displayName": "codegen_plugin",
  "description": "Code Generator and Accelerator",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "codegen-plugin.reactgenerator",
        "title": "React App Generator"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run esbuild",
    "compile": "npm run esbuild",
    "esbuild": "node esbuild.config.js",
    "watch": "node esbuild.config.js --watch",
    "prepackage": "npm run esbuild",
    "package": "vsce package",
    "pretest": "npm run esbuild && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "^1.101.0",
    "@typescript-eslint/eslint-plugin": "^8.28.0",
    "@typescript-eslint/parser": "^8.28.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "esbuild": "^0.25.5",
    "eslint": "^9.23.0",
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "@app-gen-cli/generators": "file:../../libs/generators",
    "@app-gen-cli/shared": "file:../../libs/shared"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/your-repo.git"
  }
}
